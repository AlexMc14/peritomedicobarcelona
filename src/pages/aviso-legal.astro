      <li>Razón social: {TITULAR.razonSocial}</li>
      <li>CIF: {TITULAR.cif}</li>
      <li>Domicilio: {TITULAR.domicilio}</li>
      <li>Teléfono: <a href={telHref}>{SITE.telefono}</a></li>
      <li>Correo electrónico: <a href={`mailto:${TITULAR.email}`}>{TITULAR.email}</a></li>
      <li>Nombre del dominio: {dominio}</li>
      <li>Nombre comercial: {SITE.nombre}</li>
