---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import CTASection from '../../components/CTASection.astro';
import { url } from '../../utils/links';
import { servicios, abogados } from '../../data/servicios';
import { posts } from '../../data/posts';

const landings = [...new Map(servicios.filter((s) => s.landing).map((s) => [s.landing!.href, s.landing!])).values()];
---

<Layout
  title="Servicios de Peritaje Médico en Barcelona | Perito Médico Barcelona"
  description="Todos los servicios de peritaje médico en Barcelona: negligencia médica, daño corporal, incapacidad permanente, alta médica, discapacidad, accidentes y servicios para abogados."
>
  <section class="bg-primary-950 py-16 lg:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <Breadcrumb migas={[{ nombre: 'Servicios' }]} />
        <h1 class="font-heading text-3xl sm:text-4xl lg:text-5xl font-bold text-white mb-5">Servicios de peritaje médico</h1>
        <p class="text-lg text-primary-200 leading-relaxed">
          Un perito médico elabora el informe que acredita ante un juzgado, una aseguradora o el INSS qué lesiones tiene usted, de dónde vienen y qué consecuencias le dejan. Estos son los servicios que prestamos en Barcelona y toda Cataluña. Antes de encargar nada, valoramos su caso por teléfono.
        </p>
      </div>
    </div>
  </section>

  <section class="py-16 lg:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        {servicios.map((s) => <ServiceCard title={s.nombre} description={s.descripcion} href={url(s.href)} />)}
      </div>

      <div>
        <h2 class="font-heading text-2xl font-bold text-primary-900 mb-6">Para despachos de abogados</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
          {abogados.map((a) => <ServiceCard title={a.nombre} description={a.descripcion} href={url(a.href)} />)}
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10">
        <div>
          <h2 class="font-heading text-2xl font-bold text-primary-900 mb-5">Consultas por tipo de caso</h2>
          <ul class="space-y-2.5">
            {landings.map((l) => <li><a href={url(l.href)} class="text-gray-600 hover:text-primary-900 transition-colors">{l.nombre}</a></li>)}
          </ul>
        </div>
        <div>
          <h2 class="font-heading text-2xl font-bold text-primary-900 mb-5">Guías</h2>
          <ul class="space-y-2.5">
            {posts.map((p) => <li><a href={url(p.href)} class="text-gray-600 hover:text-primary-900 transition-colors">{p.titulo}</a></li>)}
          </ul>
        </div>
      </div>

      <div class="bg-accent-50 rounded-2xl p-8 border border-accent-100 text-center">
        <h2 class="font-heading text-xl font-bold text-primary-900 mb-3">¿No sabe qué servicio necesita?</h2>
        <p class="text-gray-600 mb-5">Cuéntenos el caso y le orientamos por teléfono.</p>
        <a href={url('/perito-medico-consulta-gratuita/')} class="inline-block px-6 py-3 bg-accent-500 hover:bg-accent-600 text-white font-semibold rounded-xl transition-colors text-sm">
          Consulta telefónica
        </a>
      </div>
    </div>
  </section>

  <CTASection />
</Layout>
