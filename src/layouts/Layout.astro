---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactModal from '../components/ContactModal.astro';
import BotonesFlotantes from '../components/BotonesFlotantes.astro';
import { SITE, ORG_ID, TITULAR } from '../data/site';
import { especialidades } from '../data/servicios';
import { servicios } from '../data/servicios';
import { zonas } from '../data/zonas';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  /** ISO: fecha de última revisión de la página (WebPage.dateModified) */
  dateModified?: string;
}

const { title, noindex = false, dateModified, description = 'Perito Médico en Barcelona. Informes periciales médicos, valoración del daño corporal, negligencias médicas e incapacidad laboral. Consulta telefónica.' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="geo.region" content="ES-CT" />
    <meta name="geo.placename" content="Barcelona" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <title>{title}</title>
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:image" content={new URL(`${import.meta.env.BASE_URL}og-default.png`, Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={SITE.nombre} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta property="og:site_name" content={SITE.nombre} />
    <!-- JSON-LD global: organización (NAP único desde src/data/site.ts), web y página -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "ProfessionalService",
          "@id": ORG_ID,
          "name": SITE.nombre,
          "legalName": TITULAR.razonSocial,
          "url": `${SITE.url}/`,
          "telephone": SITE.telefono,
          "description": "Peritaje médico independiente en Barcelona y Cataluña: informes periciales de daño corporal, negligencia médica, incapacidad permanente, altas médicas y discapacidad.",
          // ponytail: sin calle ni código postal porque el repo no los tiene (aviso legal pendiente); añadirlos aquí cuando existan
          "address": { "@type": "PostalAddress", "addressLocality": "Barcelona", "addressRegion": "Cataluña", "addressCountry": "ES" },
          "areaServed": [
            { "@type": "City", "name": "Barcelona" },
            ...zonas.map((z) => ({ "@type": "Place", "name": z.nombre })),
            { "@type": "AdministrativeArea", "name": "Cataluña" }
          ],
          "knowsAbout": ["Medicina legal y forense", "Valoración del daño corporal", "Negligencia médica", "Incapacidad permanente", "Incapacidad temporal", "Discapacidad", "Baremo de tráfico (Ley 35/2015)", ...especialidades.map((e) => e.nombre)],
          "hasOfferCatalog": {
            "@type": "OfferCatalog",
            "name": "Servicios de peritaje médico",
            "itemListElement": servicios.map((s) => ({ "@type": "Offer", "itemOffered": { "@type": "Service", "name": s.nombre, "url": new URL(s.href, SITE.url).href } }))
          }
        },
        {
          "@type": "WebSite",
          "@id": `${SITE.url}/#web`,
          "url": `${SITE.url}/`,
          "name": SITE.nombre,
          "inLanguage": "es-ES",
          "publisher": { "@id": ORG_ID }
        },
        {
          "@type": "WebPage",
          "@id": canonical,
          "url": canonical,
          "name": title,
          "description": description,
          "inLanguage": "es-ES",
          "isPartOf": { "@id": `${SITE.url}/#web` },
          "about": { "@id": ORG_ID },
          ...(dateModified ? { "dateModified": dateModified } : {})
        }
      ]
    })} />
  </head>
  <body class="font-body text-gray-800 bg-white antialiased">
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <ContactModal />
    <BotonesFlotantes />
  </body>
</html>

<style is:global>
  html {
    scroll-behavior: smooth;
  }
</style>
