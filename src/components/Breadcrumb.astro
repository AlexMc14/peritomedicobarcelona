---
// Migas de pan visibles + BreadcrumbList en JSON-LD. «Inicio» se añade solo;
// la última miga (página actual) va sin href.
import { url } from '../utils/links';
import { SITE } from '../data/site';

interface Props {
  migas: { nombre: string; href?: string }[];
  class?: string;
}

const { migas, class: clase = '' } = Astro.props;
const todas = [{ nombre: 'Inicio', href: '/' }, ...migas];
const actual = new URL(Astro.url.pathname, SITE.url).href;
---

<nav aria-label="Migas de pan" class:list={['flex flex-wrap items-center gap-2 text-sm text-primary-400 mb-6', clase]}>
  {todas.map((m, i) => (
    <>
      {i > 0 && <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>}
      {m.href && i < todas.length - 1
        ? <a href={url(m.href)} class="hover:text-primary-200 transition-colors">{m.nombre}</a>
        : <span class="text-primary-200" aria-current="page">{m.nombre}</span>}
    </>
  ))}
</nav>

<script type="application/ld+json" set:html={JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: todas.map((m, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: m.nombre,
    item: i === todas.length - 1 ? actual : new URL(url(m.href!), SITE.url).href,
  })),
})} />
